/*******************************************************************************
Title:   Numbers Cited in the Write-up
Purpose: Write the derived numbers the paper text quotes as LaTeX macros, so
         none are typed by hand -> output/tables/prose_numbers.tex (+ .csv).
         Effect sizes relative to the pre-Mendez HiSeg mean (Tables 1, 2A) and the
         Panel B small-cell check (LoSeg group size, leave-one-out range).
Author:  Ibraheem Saqib Ellahi
Date:    Spring 2026
*******************************************************************************/

version 16
clear all
set more off
capture log close prose
log using "$log/06_prose_numbers.log", replace text name(prose)

use "$clean/antman_cortes_clean.dta", clear
datasignature confirm


* 1. Output Files
********************************************************************************

* One \newcommand / number, -ves get a real minus sign
* Backslashes from char(92) so Stata never reads them as escapes
program define put_num
    syntax, name(name) value(real) fmt(string) note(string)
    local s = strtrim(string(abs(`value'), "`fmt'"))
    if `value' < 0 local s = char(92) + "ensuremath{-}" + "`s'"
    local line = char(92) + "newcommand{" + char(92) + "`name'" + "}{" + "`s'" + "}  % " + "`note'"
    file write tex `"`line'"' _n
    file write csv "`name',`value',`note'" _n
    display as text "`name'" _col(26) as result "`s'" _col(52) as text "`note'"
end

file open tex using "$tab/prose_numbers.tex", write replace text
file open csv using "$tab/prose_numbers.csv", write replace text
file write tex "% Generated by code/06_prose_numbers.do, do not edit by hand" _n
file write csv "macro,value,note" _n


* 2. Table 1: DiD Relative to the Pre-Mendez HiSeg Mean
********************************************************************************

preserve
keep if hispanic == 1 & sample_tables == 1 & !missing(hiseg)
assert _N == 5630

foreach var in yrsed jrhigh hschool {
    * DiD from 4 cell means, m<post><hiseg>
    forvalues p = 0/1 {
        forvalues h = 0/1 {
            quietly summarize `var' if post_mendez == `p' & hiseg == `h'
            local m`p'`h' = r(mean)
        }
    }
    local did_`var' = (`m11' - `m10') - (`m01' - `m00')
    local base_`var' = `m01'

    * Same number as Table 1 DiD column
    regress `var' c.hiseg##c.post_mendez, robust
    assert reldif(_b[c.hiseg#c.post_mendez], `did_`var'') < 1e-8
}
restore

put_num, name(tOneDidYrsedPctBase) value(`=100 * `did_yrsed' / `base_yrsed'') fmt(%4.1f) ///
    note(Table 1 DiD years of ed as pct of 1931-35 HiSeg mean)
put_num, name(tOneDidJrhighPctBase) value(`=100 * `did_jrhigh' / `base_jrhigh'') fmt(%4.1f) ///
    note(Table 1 DiD jr high as pct of 1931-35 HiSeg mean)
put_num, name(tOneDidHschoolPctBase) value(`=100 * `did_hschool' / `base_hschool'') fmt(%4.1f) ///
    note(Table 1 DiD high school as pct of 1931-35 HiSeg mean)
put_num, name(tOneDidJrhighPp) value(`=100 * `did_jrhigh'') fmt(%4.1f) ///
    note(Table 1 DiD jr high in percentage points)
put_num, name(tOneDidHschoolPp) value(`=100 * `did_hschool'') fmt(%4.1f) ///
    note(Table 1 DiD high school in percentage points)


* 3. Table 2 Panel A: Coefficient Relative to the Pre-Mendez HiSeg Mean
********************************************************************************

* Same base paper uses for Table 2 (1931-35 HiSeg mean, Table 1)

foreach var in yrsed jrhigh hschool {
    * Eq (1), same spec as 04
    regress `var' c.hiseg#c.post_mendez female census1990 census2000 ///
        i.countyfip i.birthyr if hispanic == 1 & sample_tables == 1 & !missing(hiseg), ///
        vce(cluster countyfip)
    assert e(N) == 5630
    local b_`var' = _b[c.hiseg#c.post_mendez]
}

put_num, name(tTwoAYrsedPctBase) value(`=100 * `b_yrsed' / `base_yrsed'') fmt(%4.1f) ///
    note(Table 2A years of ed as pct of 1931-35 HiSeg mean)
put_num, name(tTwoAJrhighPctBase) value(`=100 * `b_jrhigh' / `base_jrhigh'') fmt(%4.1f) ///
    note(Table 2A jr high as pct of 1931-35 HiSeg mean)
put_num, name(tTwoAHschoolPctBase) value(`=100 * `b_hschool' / `base_hschool'') fmt(%4.1f) ///
    note(Table 2A high school as pct of 1931-35 HiSeg mean)
put_num, name(tTwoAJrhighPp) value(`=100 * `b_jrhigh'') fmt(%4.1f) ///
    note(Table 2A jr high in percentage points)
put_num, name(tTwoAHschoolPp) value(`=100 * `b_hschool'') fmt(%4.1f) ///
    note(Table 2A high school in percentage points)


* 4. Table 2 Panel B: How Small the LoSeg Placebo Group Is
********************************************************************************

* Panel B yrsed gap to paper is small-cell noise, not a bug
* Puts numbers on it: LoSeg group size, leave-one-out over those people
preserve
keep if hispanic == 1 & sample_placebo == 1 & !missing(hiseg)
assert _N == 3498

count if hiseg == 0
local n_lo = r(N)
count if hiseg == 0 & placebo_post == 0
local n_lo_pre = r(N)
count if hiseg == 0 & placebo_post == 1
local n_lo_post = r(N)
count if hiseg == 1
local n_hi = r(N)
assert `n_lo' + `n_hi' == _N

* pt estimate only, no SE needed
regress yrsed c.hiseg#c.placebo_post female census1990 census2000 i.countyfip i.birthyr
local b_full = _b[c.hiseg#c.placebo_post]

gen long obs_id = _n
label variable obs_id "Row ID for Leave-One-Out"

* drop each LoSeg person once -> min, max, biggest move
local loo_min = .
local loo_max = .
local loo_shift = 0
levelsof obs_id if hiseg == 0, local(lo_ids)
foreach i of local lo_ids {
    quietly regress yrsed c.hiseg#c.placebo_post female census1990 census2000 ///
        i.countyfip i.birthyr if obs_id != `i'
    local b = _b[c.hiseg#c.placebo_post]
    local loo_min = min(`loo_min', `b')
    local loo_max = max(`loo_max', `b')
    local loo_shift = max(`loo_shift', abs(`b' - `b_full'))
}
assert `loo_min' <= `b_full' & `b_full' <= `loo_max'
restore

put_num, name(pbLoSegN) value(`n_lo') fmt(%9.0fc) note(Panel B LoSeg people total)
put_num, name(pbLoSegPreN) value(`n_lo_pre') fmt(%9.0fc) note(Panel B LoSeg born 1921-25)
put_num, name(pbLoSegPostN) value(`n_lo_post') fmt(%9.0fc) note(Panel B LoSeg born 1926-30)
put_num, name(pbHiSegN) value(`n_hi') fmt(%9.0fc) note(Panel B HiSeg people total)
put_num, name(pbLooMin) value(`loo_min') fmt(%5.3f) ///
    note(Panel B years of ed leave-one-out over LoSeg people min)
put_num, name(pbLooMax) value(`loo_max') fmt(%5.3f) ///
    note(Panel B years of ed leave-one-out over LoSeg people max)
put_num, name(pbLooMaxShift) value(`loo_shift') fmt(%5.3f) ///
    note(Panel B years of ed largest move from dropping one LoSeg person)


* 5. Close
********************************************************************************

file close tex
file close csv

log close prose
