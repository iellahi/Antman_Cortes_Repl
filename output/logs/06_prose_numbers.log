. 
. * 1. Output Files
. ******************************************************************************
> **
. 
. * One \newcommand / number, -ves get a real minus sign
. * Backslashes from char(92) so Stata never reads them as escapes
. program define put_num
  1.     syntax, name(name) value(real) fmt(string) note(string)
  2.     local s = strtrim(string(abs(`value'), "`fmt'"))
  3.     if `value' < 0 local s = char(92) + "ensuremath{-}" + "`s'"
  4.     local line = char(92) + "newcommand{" + char(92) + "`name'" + "}{" + "`
> s'" + "}  % " + "`note'"
  5.     file write tex `"`line'"' _n
  6.     file write csv "`name',`value',`note'" _n
  7.     display as text "`name'" _col(26) as result "`s'" _col(52) as text "`no
> te'"
  8. end

. 
. file open tex using "$tab/prose_numbers.tex", write replace text
(file <repo root>/output/tables/prose_numbers
    > .tex not found)

. file open csv using "$tab/prose_numbers.csv", write replace text
(file <repo root>/output/tables/prose_numbers
    > .csv not found)

. file write tex "% Generated by code/06_prose_numbers.do, do not edit by hand" 
> _n

. file write csv "macro,value,note" _n

