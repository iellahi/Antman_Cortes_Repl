. 
. * 4. Difference-in-Differences
. ******************************************************************************
> **
. 
. matrix B = J(1, 3, .)

. matrix V = J(3, 3, 0)

. local j = 0

. foreach var in yrsed jrhigh hschool {
  2.     local ++j
  3.     regress `var' c.hiseg##c.post_mendez, robust
  4.     matrix B[1, `j'] = _b[c.hiseg#c.post_mendez]
  5.     matrix V[`j', `j'] = _se[c.hiseg#c.post_mendez]^2
  6.     if `j' == 1 {
  7.         local n = e(N)
  8.         local df = e(df_r)
  9.     }
 10.     assert e(N) == `n' & e(df_r) == `df'
 11. }

