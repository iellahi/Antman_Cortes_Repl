. matrix colnames B = `outcomes'

. matrix colnames V = `outcomes'

. matrix rownames V = `outcomes'

. post_column, b(B) v(V) n(`n') dof(`df')

. eststo did

. 
. 
. * 5. Export
. ******************************************************************************
> **
. 
. * Column order follows paper: 1941-45 High, Low, gap; 1931-35 High, Low, gap; 
> DiD
. local models "mean_p1_h1 mean_p1_h0 gap_p1 mean_p0_h1 mean_p0_h0 gap_p0 did"

. 
. * SD in brackets under means, SE in parens under gaps & DiD
. local cells `"cells("b(fmt(3) star)" "sd(fmt(3) par([ ])) & se(fmt(3) par patt
> ern(0 0 1 0 0 1 1))")"'

. 
. local rows `"coeflabels(yrsed "Years of Education" jrhigh "Jr. High (8+ years 
> of education)" hschool "High School (12+ years of education)")"'

. 
. * Log copy
. esttab `models', `cells' star(* 0.10 ** 0.05 *** 0.01) ///
>     mtitles("Hi 41-45" "Lo 41-45" "Gap 41-45" "Hi 31-35" "Lo 31-35" "Gap 31-35
> " "DiD") ///
>     nonumbers collabels(none) stats(N, fmt(%9.0fc)) modelwidth(11)

