. * LaTeX fragment (stars need \sym defined in paper preamble)
. * Long headers split over two lines so table fits the page
. esttab `models' using "$tab/table1_summary.tex", replace booktabs fragment ///
>     `cells' star(* 0.10 ** 0.05 *** 0.01) `rows' ///
>     mgroups("\begin{tabular}{c}Panel A. Treatment group\tabularnewline 1941--4
> 5 birth cohorts (ages 2--6)\end{tabular}" ///
>         "\begin{tabular}{c}Panel B. Comparison group\tabularnewline 1931--35 b
> irth cohorts (ages 12--16)\end{tabular}" "", ///
>         pattern(1 0 0 1 0 0 1) prefix(\multicolumn{@span}{c}{) suffix(}) span 
> ///
>         erepeat(\cmidrule(lr){@span})) ///
>     mtitles("High" "Low" "\ensuremath{\Delta^{\mathrm{treatment}}}" ///
>         "High" "Low" "\ensuremath{\Delta^{\mathrm{comparison}}}" ///
>         "\begin{tabular}{c}\ensuremath{\Delta^{\mathrm{treatment}}}\tabularnew
> line \ensuremath{-\,\Delta^{\mathrm{comparison}}}\end{tabular}") ///
>     nonumbers collabels(none) stats(N, fmt(%9.0fc) labels("Number of observati
> ons")) ///
>     nonotes
