. 
. use "$clean/antman_cortes_clean.dta", clear

. datasignature confirm
  (data unchanged since <date>)

. 
. * Hispanic, HiSeg/LoSeg counties, born 1931-35 or 1941-45
. keep if hispanic == 1 & sample_tables == 1 & !missing(hiseg)
(215,920 observations deleted)

. count
  5,630

. 
. 
. * 1. Helper to Store a Table Column
. ******************************************************************************
> **
. 
. * Table 1 has outcomes as rows, so each column posted as own "model"
. * with coefs named yrsed jrhigh hschool. Mean columns get V = 0 (no SE, no sta
> rs)
. program define post_column, eclass
  1.     syntax, b(name) v(name) n(integer) [sd(name) dof(integer 0)]
  2.     if `dof' > 0 {
  3.         ereturn post `b' `v', obs(`n') dof(`dof')
  4.     }
  5.     else {
  6.         ereturn post `b' `v', obs(`n')
  7.     }
  8.     if "`sd'" != "" ereturn matrix sd = `sd'
  9.     ereturn local cmd "post_column"
 10. end

. 
. local outcomes "yrsed jrhigh hschool"

. 
. 
. * 2. Means and SDs by Group
. ******************************************************************************
> **
. 
. * p = post_mendez, h = hiseg
. foreach p in 1 0 {
  2.     foreach h in 1 0 {
  3.         matrix M = J(1, 3, .)
  4.         matrix S = J(1, 3, .)
  5.         matrix V = J(3, 3, 0)
  6.         local j = 0
  7.         foreach var in yrsed jrhigh hschool {
  8.             local ++j
  9.             summarize `var' if post_mendez == `p' & hiseg == `h'
 10.             matrix M[1, `j'] = r(mean)
 11.             matrix S[1, `j'] = r(sd)
 12.         }
 13.         matrix colnames M = `outcomes'
 14.         matrix colnames S = `outcomes'
 15.         matrix colnames V = `outcomes'
 16.         matrix rownames V = `outcomes'
 17.         count if post_mendez == `p' & hiseg == `h'
 18.         post_column, b(M) v(V) sd(S) n(`r(N)')
 19.         eststo mean_p`p'_h`h'
 20.     }
 21. }

