. 
. * Cohort means for repo
. export delimited using "$tab/fig1_cohort_means.csv", replace
(file <repo root>/output/tables/fig1_cohort_m
    > eans.csv not found)
file <repo root>/output/tables/fig1_cohort_means.csv saved

. 
. 
. * 2. Create the Graph
. ******************************************************************************
> **
. 
. twoway ///
>     (line mean_white_hi age1947, lcolor(dkgreen) lpattern(longdash) lwidth(med
> ium)) ///
>     (line mean_white_lo age1947, lcolor(orange) lpattern(shortdash) lwidth(med
> ium)) ///
>     (line mean_hisp_lo age1947, lcolor(red) lpattern(dash) lwidth(medium)) ///
>     (line mean_hisp_hi age1947, lcolor(navy) lpattern(solid) lwidth(medium)), 
> ///
>     ///
>     /* Y-Axis Label and Range */ ///
>     ytitle("Average years of education") ///
>     ylabel(8(1)14, angle(0)) ///
>     ///
>     /* X-Axis Setup */ ///
>     xscale(reverse) ///
>     xlabel(26(1)2, labsize(small)) ///
>     ///
>     /* X-Title with Annotations */ ///
>     /* separate title lines put text below the numbers */ ///
>     xtitle(" " "Completed schooling                                           
>  In school                                            Prior to schooling", siz
> e(small)) ///
>     ///
>     /* Legend Placement */ ///
>     legend(order(1 "Non-Hispanic White in HiSeg" ///
>                  2 "Non-Hispanic White in LoSeg" ///
>                  3 "Hispanic in LoSeg" ///
>                  4 "Hispanic in HiSeg") ///
>            ring(0) position(5) cols(1) region(lcolor(black) fcolor(white)) siz
> e(small)) ///
>     ///
>     /* Graph Region */ ///
>     graphregion(color(white))

. 
. 
. * 3. Output the Graph
. ******************************************************************************
> **
. 
. graph export "$fig/fig1_education_by_cohort.png", replace width(2000)
(file <repo root>/output/figures/fig1_educati
    > on_by_cohort.png not found)
file <repo root>/output/figures/fig1_educati
    > on_by_cohort.png saved as PNG format

. graph export "$fig/fig1_education_by_cohort.pdf", replace
file <repo root>/output/figures/fig1_educati
    > on_by_cohort.pdf saved as PDF format

. 
