> 2482 2483 2484 2485 2486 2487 2488 2489 2490 2491 2492 2493 2494 2495 2496 249
> 7 2498

. foreach i of local lo_ids {
  2.     quietly regress yrsed c.hiseg#c.placebo_post female census1990 census20
> 00 ///
>         i.countyfip i.birthyr if obs_id != `i'
  3.     local b = _b[c.hiseg#c.placebo_post]
  4.     local loo_min = min(`loo_min', `b')
  5.     local loo_max = max(`loo_max', `b')
  6.     local loo_shift = max(`loo_shift', abs(`b' - `b_full'))
  7. }

. assert `loo_min' <= `b_full' & `b_full' <= `loo_max'

. restore

