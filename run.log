. if "$only" == "" | "$only" == "05" do "$root/code/05_event_study.do"

. /*****************************************************************************
> **
> Title:   Event Study for Antman and Cortes (2023) Replication
> Purpose: Figure 2 (jr high) plus appendix Figures A1 (years of education) and
>          A2 (high school). Model:
>          Y_ict = a + sum over t in 1921-45, t != 1931, of
>                  pi_t (HiSeg_c x 1[birthyr = t]) + X_ict b + mu_c + delta_t + 
> e_ict
>          Sample: Hispanic, born 1921-45, HiSeg or LoSeg county.
>          Reference cohort 1931 (age 16 in 1947). X = female, census1990,
>          census2000. County and birth-year FE. SE clustered by county. 90% CIs
> .
> Author:  Ibraheem Saqib Ellahi
> Date:    Spring 2026
> ******************************************************************************
> */
. 
. version 16

. clear all

. set more off

. capture log close es

. log using "$log/05_event_study.log", replace text name(es)
(file <repo root>/output/logs/05_event_study.
    > log not found)
--------------------------------------------------------------------------------
      name:  es
       log:  <repo root>/output/logs/05_event_study.log
  log type:  text
 opened on:  <date>

. 
. use "$clean/antman_cortes_clean.dta", clear

. datasignature confirm
  (data unchanged since <date>)

. 
. 
. * 1. Sample and Interaction Terms
. ******************************************************************************
> **
. 
. keep if es_sample == 1
(209,857 observations deleted)

. count
  11,693

. 
. * Each cohort needs HiSeg and LoSeg obs or its interaction not identified
. tab birthyr hiseg

           |   High Segregation
   year of |  County (Treatment)
     birth |         0          1 |     Total
-----------+----------------------+----------
      1921 |         5        221 |       226 
      1922 |        10        229 |       239 
      1923 |         8        254 |       262 
      1924 |         8        276 |       284 
      1925 |         8        368 |       376 
      1926 |        17        365 |       382 
      1927 |         6        386 |       392 
      1928 |         8        422 |       430 
      1929 |        13        388 |       401 
      1930 |        11        495 |       506 
      1931 |        17        453 |       470 
      1932 |        13        425 |       438 
      1933 |        18        411 |       429 
      1934 |        17        427 |       444 
      1935 |        12        477 |       489 
      1936 |        19        476 |       495 
      1937 |        21        446 |       467 
      1938 |        18        497 |       515 
      1939 |        30        485 |       515 
      1940 |        21        552 |       573 
      1941 |        24        517 |       541 
      1942 |        23        583 |       606 
      1943 |        43        683 |       726 
      1944 |        25        706 |       731 
      1945 |        28        728 |       756 
-----------+----------------------+----------
     Total |       423     11,270 |    11,693 

. 
. * HiSeg x cohort dummies, 1931 left out as reference (age 16 in 1947)
. * Built by hand so omitted cohort fixed, not picked by factor-variable base ru
> les
. forvalues t = 1921/1945 {
  2.     if `t' != 1931 {
  3.         gen byte hs_`t' = hiseg * (birthyr == `t')
  4.         label variable hs_`t' "HiSeg x Born `t'"
  5.     }
  6. }

. confirm new variable hs_1931

. 
. 
. * 2. Regressions, One per Outcome
. ******************************************************************************
> **
. 
. tempname memhold bt st tcrit

. tempfile coefs

. postfile `memhold' str8 outcome int birthyr int age1947 double coef double se 
> ///
>     double p double lo90 double hi90 long nobs using "`coefs'"

. 
. foreach var in jrhigh yrsed hschool {
  2. 
.     regress `var' hs_* female census1990 census2000 i.countyfip i.birthyr, vce
> (cluster countyfip)
  3. 
. * 24 interactions, NONE dropped for collinearity
.     local nint = 0
  4.     forvalues t = 1921/1945 {
  5.         if `t' != 1931 {
  6.             assert _se[hs_`t'] > 0
  7.             local ++nint
  8.         }
  9.     }
 10.     display "`var': `nint' interactions estimated, reference cohort 1931"
 11.     assert `nint' == 24
 12. 
. * 90% CI uses t w/ clustered df, same as regress
.     scalar `tcrit' = invttail(e(df_r), 0.05)
 13. 
.     forvalues t = 1921/1945 {
 14.         if `t' == 1931 {
 15.             post `memhold' ("`var'") (`t') (1947 - `t') (0) (0) (.) (0) (0)
