. 
. foreach var in jrhigh yrsed hschool {
  2. 
. * room under CI band for group labels
.     quietly summarize lo90 if outcome == "`var'"
  3.     local ymin = r(min)
  4.     quietly summarize hi90 if outcome == "`var'"
  5.     local ymax = r(max)
  6.     local ytxt = `ymin' - 0.1 * (`ymax' - `ymin')
  7. 
. * Blue dashed at 16 & 12, red at 6 & 2, as in paper
.     twoway ///
>         (rarea hi90 lo90 age1947 if outcome == "`var'", color(gs13) lwidth(non
> e)) ///
>         (connected coef age1947 if outcome == "`var'", lcolor(black) mcolor(bl
> ack) ///
>             msymbol(plus) mlabel(coef_lab) mlabvposition(lab_pos) mlabsize(vsm
> all) mlabcolor(black)), ///
>         yline(0, lcolor(black) lwidth(thin)) ///
>         xline(16 12, lpattern(dash) lcolor(navy)) ///
>         xline(6 2, lpattern(dash) lcolor(red)) ///
>         xscale(reverse) ///
>         xlabel(2(1)15 16 "16{sup:†}" 17(1)26, labsize(small)) ///
>         ylabel(`ylab_`var'', angle(0) labsize(small)) ///
>         yscale(range(`ytxt' `ymax')) ///
>         text(`ytxt' 14 "Old group", color(navy) size(small)) ///
>         text(`ytxt' 4 "Young group", color(red) size(small)) ///
>         ytitle("") ///
>         xtitle("Age at Mendez versus Westminster Decision") ///
>         legend(order(2 "Difference between high and low likelihood" "segregate
> d counties (high - low)") ///
>             ring(0) position(11) cols(1) region(lcolor(black) fcolor(white)) s
> ize(small)) ///
>         graphregion(color(white))
  8. 
.     graph export "$fig/`fname_`var''.png", replace width(2000)
  9.     graph export "$fig/`fname_`var''.pdf", replace
 10. }
