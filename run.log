. 
. * 3. HiSeg - LoSeg Gap Within Cohort
. ******************************************************************************
> **
. 
. foreach p in 1 0 {
  2.     matrix B = J(1, 3, .)
  3.     matrix V = J(3, 3, 0)
  4.     local j = 0
  5.     foreach var in yrsed jrhigh hschool {
  6.         local ++j
  7.         regress `var' hiseg if post_mendez == `p', robust
  8.         matrix B[1, `j'] = _b[hiseg]
  9.         matrix V[`j', `j'] = _se[hiseg]^2
 10.         * same N, df for all 3
.         if `j' == 1 {
 11.             local n = e(N)
 12.             local df = e(df_r)
 13.         }
 14.         assert e(N) == `n' & e(df_r) == `df'
 15.     }
 16.     matrix colnames B = `outcomes'
 17.     matrix colnames V = `outcomes'
 18.     matrix rownames V = `outcomes'
 19.     post_column, b(B) v(V) n(`n') dof(`df')
 20.     eststo gap_p`p'
 21. }

