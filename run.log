. 
. * 5. Variable Construction I
. ******************************************************************************
> **
. 
. * A. Outcome Variables
. ******************************************************************************
> **
. 
. * Years of Education
. do "$root/code/lib/yrsed.do"

. /*****************************************************************************
> **
> Title:   Years of Schooling Crosswalk
> Purpose: EDUCD -> years of schooling (0-20). Called by 01_build_data.do,
>          needs educd in memory, creates yrsed.
> Author:  Ibraheem Saqib Ellahi
> Date:    Spring 2026
> ******************************************************************************
> */
. 
. gen yrsed=.
(221,550 missing values generated)

. replace yrsed=0 if inlist(educd, 2, 10, 11, 12)
(1,911 real changes made)

. replace yrsed=1 if inlist(educd, 13, 14)
(475 real changes made)

. replace yrsed=2 if educd==15
(152 real changes made)

. replace yrsed=3 if educd==16
(173 real changes made)

. replace yrsed=4 if educd==17
(192 real changes made)

. replace yrsed=5 if inlist(educd, 20, 21, 22)
(3,183 real changes made)

. replace yrsed=6 if educd==23
(518 real changes made)

. replace yrsed=7 if inlist(educd, 24, 25)
(1,986 real changes made)

. replace yrsed=8 if educd==26
(1,967 real changes made)

. replace yrsed=9 if educd==30
(5,114 real changes made)

. replace yrsed=10 if educd==40
(8,310 real changes made)

. replace yrsed=11 if inlist(educd, 50, 61)
(14,002 real changes made)

. replace yrsed=12 if inlist(educd, 60, 62, 65)  // 12 yrs or GED or <1 yr coll
(72,776 real changes made)

. replace yrsed=13 if inlist(educd, 70, 71) // 1 yr college or 1 yr and no degre
> e
(37,161 real changes made)

. replace yrsed=14 if inlist(educd, 80, 81, 82, 83) // 2 yrs college or Associat
> es
(20,263 real changes made)

. replace yrsed=15 if educd==90
(3,527 real changes made)

. replace yrsed=16 if inlist(educd, 100, 101) // 4 yrs college or Bachelors
(27,732 real changes made)

. replace yrsed=17 if educd==110
(3,400 real changes made)

. replace yrsed=18 if inlist(educd, 111, 114) // 6 yrs college or Masters
(10,813 real changes made)

. replace yrsed=19 if inlist(educd, 112, 115) // 7 yrs college or Prof Deg
(4,462 real changes made)

. replace yrsed=20 if inlist(educd, 113, 116) // 8+ yrs college or doctoral degr
> ee
(3,433 real changes made)

. 
. label var yrsed "Years of schooling"

. 
end of do-file

. label variable yrsed "Years of Education"

. 
. * crosswalk has to cover every EDUCD code left
. count if missing(yrsed)
  0

. assert !missing(yrsed)

. 
. * Jr. High Completion (8+ years)
. gen jrhigh = yrsed >= 8

. label variable jrhigh "Completed Jr. High (8+ Years)"

. 
. * High School Completion (12+ years)
. gen hschool = yrsed >= 12

. label variable hschool "Completed High School (12+ Years)"

. 
. 
. * B. Explanatory Variables (Difference-in-Differences)
. ******************************************************************************
> **
. 
. * Post-Treatment (PostMendez), born 1941-45
. gen post_mendez = inrange(birthyr, 1941, 1945)

. label variable post_mendez "Post-Mendez Cohort (Born 1941-45)"

. 
. * Interaction Term (DiD Estimator), missing outside HiSeg/LoSeg counties
. gen did_interaction = hiseg * post_mendez
(154,363 missing values generated)

. label variable did_interaction "HiSeg x PostMendez"

. 
. * Placebo post cohort for Panel B, born 1926-30
. gen placebo_post = inrange(birthyr, 1926, 1930)

. label variable placebo_post "Placebo Post-Mendez Cohort (Born 1926-30)"

. 
. * Inspect
. summarize yrsed jrhigh hschool hiseg post_mendez did_interaction placebo_post

