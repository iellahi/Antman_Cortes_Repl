. * 2. Table 1: DiD Relative to the Pre-Mendez HiSeg Mean
. ******************************************************************************
> **
. 
. preserve

. keep if hispanic == 1 & sample_tables == 1 & !missing(hiseg)
(215,920 observations deleted)

. assert _N == 5630

. 
. foreach var in yrsed jrhigh hschool {
  2.     * DiD from 4 cell means, m<post><hiseg>
.     forvalues p = 0/1 {
  3.         forvalues h = 0/1 {
  4.             quietly summarize `var' if post_mendez == `p' & hiseg == `h'
  5.             local m`p'`h' = r(mean)
  6.         }
  7.     }
  8.     local did_`var' = (`m11' - `m10') - (`m01' - `m00')
  9.     local base_`var' = `m01'
 10. 
. * Same number as Table 1 DiD column
.     regress `var' c.hiseg##c.post_mendez, robust
 11.     assert reldif(_b[c.hiseg#c.post_mendez], `did_`var'') < 1e-8
 12. }

